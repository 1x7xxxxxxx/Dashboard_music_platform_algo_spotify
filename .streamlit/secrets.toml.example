# Gabarit — la connexion Google (OIDC natif Streamlit ≥ 1.42, ici 1.63).
#
# ⚠️ COPIE-LE en `.streamlit/secrets.toml` et NE COMMITE JAMAIS la copie.
#     Elle est exclue de `.gitignore` ET de `.dockerignore` — les DEUX, parce que ce
#     sont deux frontières distinctes et que n'en franchir qu'une donne exactement
#     l'impression d'être protégé. Le `Dockerfile` porte `COPY .streamlit/`, donc
#     sans l'exclusion du contexte de build le secret partirait dans une couche
#     d'image, d'où il ne s'efface plus.
#     Garde : `tests/test_a_secret_never_rides_into_an_image_layer.py`.
#
# ⚠️ EN PRODUCTION, ce fichier se MONTE en volume. Il ne se construit pas dans
#     l'image, et il ne se copie pas dans le dépôt.
#
# Sans ce fichier, l'application marche exactement comme avant : le bouton
# « Se connecter avec Google » ne s'affiche pas, et le mot de passe reste le seul
# chemin. C'est délibéré — un bouton qui mène à un plantage vaut moins qu'un bouton
# absent.

[auth]
# ── L'URI DE REDIRECTION ──────────────────────────────────────────────────────
# Google exige une correspondance EXACTE : schéma, hôte, port, chemin. Aucun joker.
# Elle doit être déclarée à l'identique dans la console Google Cloud.
#
# En local :
redirect_uri = "http://localhost:8501/oauth2callback"
# En production, l'hôte CANONIQUE et lui seul — `streamlytics.fr` et
# `www.streamlytics.fr` redirigent vers lui en 308 avant que le flux ne commence
# (`deploy/Caddyfile`). Déclarer trois URI marcherait aussi, mais donnerait trois
# cookies d'identité distincts : se connecter sur `www.` ne connecterait pas sur
# `app.`, et personne ne comprendrait pourquoi.
#     redirect_uri = "https://app.streamlytics.fr/oauth2callback"

# ── LE SECRET DU COOKIE D'IDENTITÉ ────────────────────────────────────────────
# Il signe le cookie que Streamlit pose après la connexion. Un secret faible ou
# partagé entre environnements permettrait de fabriquer un cookie valide.
# Générer :  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
cookie_secret = ""   # pragma: allowlist secret — gabarit vide, à remplir

# ── L'IDENTIFIANT CLIENT OAUTH ────────────────────────────────────────────────
# Console Google Cloud → API et services → Identifiants → ID client OAuth 2.0,
# type « Application Web ».
client_id = ""       # se termine par .apps.googleusercontent.com
client_secret = ""   # pragma: allowlist secret — gabarit vide, à remplir

# ── LES SCOPES, ET POURQUOI CEUX-LÀ SEULEMENT ─────────────────────────────────
# `openid email profile` sont les scopes NON SENSIBLES de Google. Une application
# qui ne demande qu'eux :
#   * n'a PAS besoin de passer la vérification Google (dossier, domaine vérifié,
#     vidéo de démonstration) pour être publiée « In production » ;
#   * n'affiche PAS l'écran « Google n'a pas vérifié cette application » ;
#   * échappe au plafond de 100 utilisateurs de test et à l'expiration des
#     autorisations au bout de 7 jours en mode « Testing ».
#
# ⚠️ C'est exactement ce qui distingue ce cas de R105, abandonnée le 2026-09-13 :
#     `yt-analytics.readonly` et `youtube.readonly` sont des scopes SENSIBLES, et
#     c'est leur niveau — pas Google en général — qui imposait le dossier de
#     vérification. Ajouter ici le moindre scope supplémentaire fait basculer
#     l'application dans ce régime-là. Ne rien ajouter.
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
