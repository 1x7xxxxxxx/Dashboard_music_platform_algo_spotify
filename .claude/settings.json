{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Write(./.env)",
      "Edit(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/*credentials*.json)",
      "Read(**/*service*account*.json)",
      "Bash(sudo rm:*)",
      "Bash(mkfs:*)",
      "Bash(mkfs.*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)"
    ],
    "ask": [
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)"
    ],
    "_comment_allow": [
      "Ces règles vivent ICI et pas dans settings.local.json pour une raison mesurée",
      "le 2026-08-21 : quand on approuve une permission en séance, Claude Code réécrit",
      "settings.local.json depuis sa copie en mémoire — et cette copie est antérieure à",
      "toute édition faite pendant la séance. 40 règles ajoutées y ont été effacées",
      "sans un mot. settings.json, lui, n'est pas réécrit par le harnais, et il est versionné."
    ],
    "allow": [
