# Caddyfile — streaMLytics reverse proxy (prod, Hetzner 167.233.92.1)
# ----------------------------------------------------------------------------
# COPIE FIDÈLE de /etc/caddy/Caddyfile en production, relevée le 2026-08-22.
#
# Ce fichier était périmé et personne ne le savait. Il décrivait le déploiement
# de juin — Let's Encrypt, pas de journalisation, pas de lb_try_duration — alors
# que la prod tourne depuis sur des CERTIFICATS D'ORIGINE CLOUDFLARE, avec un
# bloc de log qui supprime Cookie/Authorization/Set-Cookie, et l'apex servi dans
# le même bloc que `app`. Appliquer l'ancien fichier aurait cassé TLS et perdu la
# rédaction des journaux ajoutée le 2026-06-14.
#
# Découvert en voulant y appliquer un correctif : j'ai édité le fichier du dépôt
# en croyant éditer ce qui tourne. Rien ne compare les deux — `make sync-check`
# vérifie le schéma et le HEAD git, pas la config du reverse proxy.
#
# Déploiement : ce fichier n'est PAS appliqué automatiquement. Pour le pousser :
#   scp deploy/Caddyfile root@HOST:/etc/caddy/Caddyfile.new
#   ssh root@HOST 'caddy validate --config /etc/caddy/Caddyfile.new \
#     && cp /etc/caddy/Caddyfile /etc/caddy/Caddyfile.bak-$(date +%Y%m%d) \
#     && mv /etc/caddy/Caddyfile.new /etc/caddy/Caddyfile && systemctl reload caddy'
#
# `email` est celui du compte ACME réel ; ne pas le changer sans raison.
# ----------------------------------------------------------------------------

{
	email 1x7xxxxxxx@gmail.com
}
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Ajoutes 2026-08-22 (R22) : le dashboard renvoyait 4 en-tetes, l API 6.
		# Les deux de plus viennent du middleware FastAPI, pas d ici.
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		X-Permitted-Cross-Domain-Policies "none"
		-Server
	}
}
(logging) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format filter {
			wrap json
			request>headers>Cookie delete
			request>headers>Authorization delete
			resp_headers>Set-Cookie delete
		}
	}
}
(proxy_opts) {
	lb_try_duration 5s
	lb_try_interval 250ms
}
streamlytics.fr, www.streamlytics.fr, app.streamlytics.fr {
	tls /etc/caddy/origin.pem /etc/caddy/origin.key
	import security_headers
	# CSP du DASHBOARD seulement. Pas dans (security_headers) : Caddy REMPLACE
	# l en-tete, et le middleware FastAPI pose deja `default-src none` sur l API,
	# strictement plus strict que ceci. Rien sur script-src/style-src ici, qui
	# blanchirait Streamlit (inline + eval) ; ces quatre directives limitent ce
	# qu une injection reussie peut faire sans toucher au chargement des assets.
	header Content-Security-Policy "object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	import logging
	encode gzip zstd
	# The setup guide as a WEB PAGE, from the repo checkout, before the proxy.
	# Added 2026-09-03. The guide existed only as a committed PDF, and that PDF had
	# been 82 days behind its sources without anything noticing — a document is fixed
	# by redistributing it, a page by saving it. Caddy runs as a host systemd service
	# here, so `root *` reads the checkout directly: no volume, no image, no rebuild.
	# `handle` must precede `reverse_proxy` or Streamlit swallows the path.
	handle /guide* {
		root * /opt/streamlytics/docs/guides
		try_files {path} /index.html
		file_server
	}
	reverse_proxy 127.0.0.1:8501 {
		import proxy_opts
	}
}
api.streamlytics.fr {
	tls /etc/caddy/origin.pem /etc/caddy/origin.key
	import security_headers
	import logging
	encode gzip zstd
	reverse_proxy 127.0.0.1:8502 {
		import proxy_opts
	}
}
