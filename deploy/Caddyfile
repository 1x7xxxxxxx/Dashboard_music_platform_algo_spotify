# Caddyfile — streaMLytics reverse proxy (prod, Hetzner 167.233.92.1)
# ----------------------------------------------------------------------------
# COPIE FIDÈLE de /etc/caddy/Caddyfile en production, relevée le 2026-08-22.
#
# Ce fichier était périmé et personne ne le savait. Il décrivait le déploiement
# de juin — Let's Encrypt, pas de journalisation, pas de lb_try_duration — alors
# que la prod tourne depuis sur des CERTIFICATS D'ORIGINE CLOUDFLARE, avec un
# bloc de log qui supprime Cookie/Authorization/Set-Cookie, et l'apex servi dans
# le même bloc que `app`. Appliquer l'ancien fichier aurait cassé TLS et perdu la
# rédaction des journaux ajoutée le 2026-06-14.
#
# Découvert en voulant y appliquer un correctif : j'ai édité le fichier du dépôt
# en croyant éditer ce qui tourne. Rien ne compare les deux — `make sync-check`
# vérifie le schéma et le HEAD git, pas la config du reverse proxy.
#
# Déploiement : ce fichier n'est PAS appliqué automatiquement. Pour le pousser :
#   scp deploy/Caddyfile root@HOST:/etc/caddy/Caddyfile.new
#   ssh root@HOST 'caddy validate --config /etc/caddy/Caddyfile.new \
#     && cp /etc/caddy/Caddyfile /etc/caddy/Caddyfile.bak-$(date +%Y%m%d) \
#     && mv /etc/caddy/Caddyfile.new /etc/caddy/Caddyfile && systemctl reload caddy'
#
# `email` est celui du compte ACME réel ; ne pas le changer sans raison.
# ----------------------------------------------------------------------------

{
	email 1x7xxxxxxx@gmail.com
	# L'endpoint d'administration, sur la PASSERELLE du reseau des conteneurs.
	#
	# Par defaut il ecoute sur 127.0.0.1:2019 — la loopback de l'HOTE, qu'un conteneur
	# ne peut pas atteindre. Prometheus tourne dans un conteneur : sa cible `caddy`
	# restait `down` avec `connection refused`, et les 66 series `caddy_http_*` etaient
	# exposees pour personne. C'est la classe `a-bind-address-that-hides-the-service`,
	# rencontree deux fois le meme jour et dans les deux sens.
	#
	# 172.18.0.1 est la passerelle du reseau `airflow_network` : joignable par les
	# conteneurs, et PAS depuis Internet (adresse privee, et le pare-feu ne l'expose
	# pas). ⚠️ L'API d'administration de Caddy peut RECONFIGURER le serveur — la lier a
	# 0.0.0.0 serait une porte ouverte, jamais un raccourci.
	#
	# Consequence a connaitre : les outils de l'hote qui interrogeaient
	# `127.0.0.1:2019` doivent viser `172.18.0.1:2019`.
	admin 172.18.0.1:2019
	# Les metriques HTTP par amont — posees le 2026-09-16 (ADR-026).
	#
	# Sans cette directive, `curl 127.0.0.1:2019/metrics` ne rend QUE les metriques Go
	# du processus et `caddy_reverse_proxy_upstreams_healthy` : verifie, `caddy_http_*`
	# y comptait ZERO ligne. On croyait donc avoir la latence vue du reverse proxy, et
	# on ne l'avait pas.
	#
	# Ce qu'elle ajoute : `caddy_http_request_duration_seconds` et
	# `caddy_http_requests_total` avec un label par serveur et par code. C'est le seul
	# endroit d'ou l'on peut comparer les DEUX amonts du dashboard (8501 et 8511) sans
	# instrumenter l'application.
	#
	# ⚠️ Ce qu'elle ne donne PAS : la duree d'un RERUN. Les reruns voyagent dans le
	# websocket `/_stcore/stream`, dont la duree p50 de session est de 252 SECONDES —
	# Caddy voit une requete par ONGLET, pas une par rerun. C'est mesure, et c'est la
	# raison pour laquelle l'instrumentation applicative existe quand meme.
	#
	# L'endpoint d'administration reste sur son defaut 127.0.0.1:2019 : jamais expose.
	servers {
		metrics
	}
}
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Ajoutes 2026-08-22 (R22) : le dashboard renvoyait 4 en-tetes, l API 6.
		# Les deux de plus viennent du middleware FastAPI, pas d ici.
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		X-Permitted-Cross-Domain-Policies "none"
		-Server
	}
}
(logging) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format filter {
			wrap json
			request>headers>Cookie delete
			request>headers>Authorization delete
			resp_headers>Set-Cookie delete
		}
	}
}
(proxy_opts) {
	lb_try_duration 5s
	lb_try_interval 250ms
}
# L'HOTE CANONIQUE — pose le 2026-09-22 avec la connexion Google.
#
# Google exige une URI de redirection EXACTE : meme schema, meme hote, meme port,
# meme chemin, et aucun joker. Trois hotes servaient le meme dashboard, donc trois
# parcours possibles pour un seul `redirect_uri` declare dans `secrets.toml`.
#
# Deux facons de traiter ca. Declarer trois URI chez Google marche, mais donne TROIS
# cookies d'identite distincts : se connecter sur `www.` ne connecte pas sur `app.`,
# et personne ne comprend pourquoi. Rediriger vers un hote canonique AVANT le flux
# laisse une seule URI, un seul cookie, un seul parcours — c'est la pratique
# recommandee, et c'est ce qu'on fait ici.
#
# 308 et non 302 : la methode et le corps sont preserves, donc un POST en cours de
# route n'est pas transforme en GET. La redirection est permanente parce que le choix
# l'est ; si l'hote canonique changeait, il faudrait purger les caches des visiteurs.
streamlytics.fr, www.streamlytics.fr {
	tls /etc/caddy/origin.pem /etc/caddy/origin.key
	import security_headers
	import logging
	redir https://app.streamlytics.fr{uri} 308
}
app.streamlytics.fr {
	tls /etc/caddy/origin.pem /etc/caddy/origin.key
	import security_headers
	# CSP du DASHBOARD seulement. Pas dans (security_headers) : Caddy REMPLACE
	# l en-tete, et le middleware FastAPI pose deja `default-src none` sur l API,
	# strictement plus strict que ceci. Rien sur script-src/style-src ici, qui
	# blanchirait Streamlit (inline + eval) ; ces quatre directives limitent ce
	# qu une injection reussie peut faire sans toucher au chargement des assets.
	header Content-Security-Policy "object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	import logging
	encode gzip zstd
	# The setup guide as a WEB PAGE, from the repo checkout, before the proxy.
	# Added 2026-09-03. The guide existed only as a committed PDF, and that PDF had
	# been 82 days behind its sources without anything noticing — a document is fixed
	# by redistributing it, a page by saving it. Caddy runs as a host systemd service
	# here, so `root *` reads the checkout directly: no volume, no image, no rebuild.
	# `handle` must precede `reverse_proxy` or Streamlit swallows the path.
	handle /guide* {
		root * /opt/streamlytics/docs/guides
		# `strip_prefix` est obligatoire, pas cosmetique : sans lui Caddy cherche
		# `docs/guides/guide/img/x.png` et retombe sur index.html. La premiere version
		# de cette page encapsulait ses images en base64, ce qui MASQUAIT le defaut :
		# le repli servait un document complet. Externaliser les images l a revele.
		uri strip_prefix /guide
		# Les captures sont nommees par hash de contenu : une image qui change change
		# de nom, donc un cache long ne peut pas servir une version perimee. Sans cet
		# en-tete le lecteur retelechargeait 700 Ko a chaque visite.
		@img path *.png
		header @img Cache-Control "public, max-age=31536000, immutable"
		header Cache-Control "public, max-age=300"
		try_files {path} /index.html
		file_server
	}
	# UN SEUL AMONT — et le second est ARRETE, pas oublie (R114, 2026-09-16).
	#
	# L'experience a tourne : deux repliques derriere `lb_policy cookie`, mesurees a
	# 1/4/8/12/24 onglets. Le p50 s'effondre (x2,25 a 24 onglets : 3088 ms -> 1374 ms)
	# et les reruns PERDUS ne suivent pas (37 -> 35). Les deux chiffres ne racontent pas
	# la meme histoire, et l'audit de l'instrument a montre pourquoi : la colonne
	# « perdus » melange trois causes dont une seule parle du serveur, et le p50 est
	# calcule sur les seuls survivants (68-82 % de censure a N=24).
	#
	# On ne garde donc PAS la seconde replique sur la foi d'une mesure ambigue. Elle
	# reste arretee jusqu'a ce que l'instrumentation serveur (ADR-026 : Prometheus,
	# `streamlit_rerun_duration_seconds`) rende un chiffre qui ne depende pas de la
	# saturation du client. La decision definitive ira dans un ADR, avec la courbe.
	#
	# Ce qui reste EN PLACE pendant l'arret, et qu'il ne faut pas defaire :
	#   - les seaux anti-force-brute sont en BASE (migration 122). C'est ce qui rend un
	#     second amont possible ; en memoire, chaque instance aurait son propre budget et
	#     un forceur scripte — sans bocal a cookies, donc reparti en tourniquet — verrait
	#     `budget x N`. `tests/test_in_memory_limits_forbid_replicas.py` l'interdit
	#     mecaniquement : remettre l'amont ci-dessous avec des seaux en memoire fait
	#     rougir la suite AVANT la prod.
	#   - l'invalidation de cache inter-instances (migration 123) ;
	#   - la sonde de sante du port 8511 dans `tools/deploy.sh:service_probe()`, que
	#     `tests/test_a_deploy_covers_every_service_it_starts.py` exige.
	#
	# REMISE EN SERVICE, quand la courbe l'aura dit — les deux gestes, dans cet ordre :
	#   1. demarrer la replique :
	#        docker compose -f docker-compose.yml -f deploy/docker-compose.replica.yml \\
	#          --profile replica up -d dashboard2
	#   2. remplacer la ligne `reverse_proxy` ci-dessous par :
	#        reverse_proxy 127.0.0.1:8501 127.0.0.1:8511 {
	#            lb_policy cookie streamlytics_lb
	#      puis `caddy validate` sur la machine, puis `systemctl reload caddy` — jamais
	#      `restart`.
	#   3. remettre la cible de scrutation dans `deploy/prometheus/prometheus.yml` :
	#        - targets: ['streamlytics_dashboard2:9102']
	#          labels: {instance_role: replica}
	#      puis recreer le conteneur Prometheus. Elle en a ete RETIREE avec l'amont, parce
	#      qu'une replique eteinte reste `down` pour toujours et qu'un rouge permanent
	#      apprend a lire le rouge comme du bruit. Sans ce geste la replique sert du
	#      trafic sans etre mesuree — c'est-a-dire qu'on refait l'experience R114 en
	#      aveugle.
	#
	# ⚠️ `lb_policy cookie` n'est PAS une optimisation : `st.session_state` vit dans le
	# PROCESSUS. Une requete routee vers l'autre instance perd la session. Et meme avec
	# l'affinite, le redemarrage de l'instance epinglee fait rebasculer l'utilisateur via
	# `lb_try_duration` vers un amont qui n'a pas son etat — deconnexion silencieuse en
	# pleine session. Aujourd'hui, a un amont, un deploiement fait subir cela a tout le
	# monde en meme temps ; a deux, l'effet est etale mais reste reel.
	reverse_proxy 127.0.0.1:8501 {
		import proxy_opts
	}
}
api.streamlytics.fr {
	tls /etc/caddy/origin.pem /etc/caddy/origin.key
	import security_headers
	import logging
	encode gzip zstd
	reverse_proxy 127.0.0.1:8502 {
		import proxy_opts
	}
}
